[Unit]
Description=shbox SSH sandbox daemon
Wants=network-online.target shbox-idmap-broker.socket
After=network-online.target shbox-idmap-broker.socket

[Service]
Type=simple
# This must be a dedicated, unprivileged account.
User=shbox
Group=shbox
WorkingDirectory=/var/lib/shbox
ExecStart=/usr/local/bin/shbox --listen tcp://0.0.0.0:2222 --log-level info
Restart=on-failure
RestartSec=2s
# KillMode=control-group is a systemd service-manager cleanup choice only.
# shbox writes cgroupfs solely when [sandbox] resource limits are configured;
# delegate the unit subtree so shbox can own its sandbox cgroups. The service
# process stays in a leaf while the delegated unit cgroup remains an internal
# node for shbox's sandbox subtree.
# Explicit controller delegation is required for an unprivileged User= service.
# systemd makes these controllers available to the delegated subtree; shbox
# enables them in cgroup.subtree_control when a child limit needs them.
Delegate=cpu memory pids
DelegateSubgroup=daemon
KillMode=control-group
TimeoutStopSec=10s
UMask=0077

# The daemon invokes root-owned setuid shadow helpers for the parent-side
# user-namespace map. The user child sets NNP before executing user code.
NoNewPrivileges=false

# xdg's application prefix adds /shbox to each of these roots. Keep data and
# state roots separate: shbox holds independent locks in both locations.
Environment=XDG_CONFIG_HOME=/etc
Environment=XDG_DATA_HOME=/var/lib
Environment=XDG_STATE_HOME=/var/lib/shbox-state
Environment=HOME=/var/lib/shbox
PrivateTmp=true

[Install]
WantedBy=multi-user.target
