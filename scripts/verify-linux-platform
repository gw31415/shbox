#!/usr/bin/env bash
# M8 blocking Linux platform gate.
#
# This gate is intentionally fail-closed. It must be run on the native target
# under a non-root account with a delegated cgroup v2 parent. The gate builds
# the Arapuca wrapper from the pinned revision before running the suite.

set -euo pipefail

readonly ARAPUCA_REVISION="c94802c4d8b6b880334c0d643b16b7326ec7f039"
readonly ARAPUCA_VERSION="0.2.7"
readonly ARAPUCA_GIT_URL="https://github.com/LeGambiArt/arapuca"

die() {
  printf 'M8 Linux gate: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat >&2 <<'EOF'
usage: scripts/verify-linux-platform --arch x86_64|aarch64 [--target TARGET]

The gate requires a native Linux runner, a non-root account, a delegated
cgroup v2 parent, and builds the Arapuca wrapper from the pinned revision
before running the suite.
EOF
  exit 2
}

expected_arch=''
target=''
while (($# > 0)); do
  case "$1" in
    --arch)
      (($# >= 2)) || usage
      expected_arch="$2"
      shift 2
      ;;
    --arch=*)
      expected_arch="${1#*=}"
      shift
      ;;
    --target)
      (($# >= 2)) || usage
      target="$2"
      shift 2
      ;;
    --target=*)
      target="${1#*=}"
      shift
      ;;
    -h|--help)
      usage
      ;;
    *)
      usage
      ;;
  esac
done

case "$expected_arch" in
  x86_64)
    expected_machine='x86_64'
    default_target='x86_64-unknown-linux-gnu'
    ;;
  aarch64)
    expected_machine='aarch64'
    default_target='aarch64-unknown-linux-gnu'
    ;;
  *)
    usage
    ;;
esac

if [[ -z "$target" ]]; then
  target="$default_target"
fi
[[ "$target" == "$default_target" ]] || die "target $target does not match native $expected_arch gate"

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd -- "$repo_root"

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "required command is missing: $1"
}

for command_name in awk cargo cat grep id mktemp rustc sh ssh ssh-keygen uname; do
  require_command "$command_name"
done

toml_pin="arapuca = { git = \"$ARAPUCA_GIT_URL\", rev = \"$ARAPUCA_REVISION\" }"
grep -Fqx "$toml_pin" Cargo.toml || die "Cargo.toml does not pin Arapuca revision $ARAPUCA_REVISION"
lock_source="source = \"git+$ARAPUCA_GIT_URL?rev=$ARAPUCA_REVISION#$ARAPUCA_REVISION\""
awk -v expected_version='version = "0.2.7"' -v expected_source="$lock_source" '
  $0 == "[[package]]" { inside = 0 }
  $0 == "name = \"arapuca\"" { inside = 1; seen = 1; next }
  inside && $0 == expected_version { version = 1 }
  inside && $0 == expected_source { source = 1 }
  END { exit !(seen && version && source) }
' Cargo.lock || die "Cargo.lock does not contain Arapuca 0.2.7 at revision $ARAPUCA_REVISION"

[[ "$(uname -s)" == 'Linux' ]] || die "runner OS is not Linux"
actual_machine="$(uname -m)"
[[ "$actual_machine" == "$expected_machine" ]] || die "runner architecture is $actual_machine, expected $expected_machine"

for command_name in cut mkdir rmdir; do
  require_command "$command_name"
done

uid="$(id -u)"
[[ "$uid" != '0' ]] || die "the platform gate must run as a non-root account"
runner_user="$(id -un)"
if [[ -n "${SHBOX_EXPECTED_USER:-}" && "$runner_user" != "$SHBOX_EXPECTED_USER" ]]; then
  die "runner account is $runner_user, expected dedicated account $SHBOX_EXPECTED_USER"
fi

kernel_release="$(uname -r)"
kernel_major="${kernel_release%%.*}"
kernel_tail="${kernel_release#*.}"
kernel_minor="${kernel_tail%%.*}"
[[ "$kernel_major" =~ ^[0-9]+$ && "$kernel_minor" =~ ^[0-9]+$ ]] || die "cannot parse Linux kernel release: $kernel_release"
if ((kernel_major < 5 || (kernel_major == 5 && kernel_minor < 13))); then
  die "Linux kernel $kernel_release is older than the required 5.13"
fi

cgroup_mount='/sys/fs/cgroup'
[[ -r "$cgroup_mount/cgroup.controllers" ]] || die "cgroups v2 is not mounted at $cgroup_mount"
[[ -r "$cgroup_mount/cgroup.subtree_control" ]] || die "cgroups v2 subtree control is unavailable"

cgroup_relative="$(awk -F: '$1 == "0" { print $3; exit }' /proc/self/cgroup)"
[[ -n "$cgroup_relative" && "$cgroup_relative" != '/' ]] || die "the gate is running in the cgroup root, not a delegated service scope"
[[ "$cgroup_relative" != *'..'* ]] || die "the current cgroup path is invalid"
cgroup_relative="${cgroup_relative#/}"
cgroup_path="$cgroup_mount/$cgroup_relative"
[[ -d "$cgroup_path" ]] || die "current cgroup does not resolve below $cgroup_mount"

required_controllers=(cpu cpuset memory pids)
for controller in "${required_controllers[@]}"; do
  grep -Eq "(^|[[:space:]])${controller}($|[[:space:]])" "$cgroup_path/cgroup.controllers" || \
    die "controller $controller is not delegated by $cgroup_path"
  grep -Eq "(^|[[:space:]])${controller}($|[[:space:]])" "$cgroup_path/cgroup.subtree_control" || \
    die "controller $controller is not enabled in $cgroup_path/cgroup.subtree_control"
done
[[ -w "$cgroup_path/cgroup.procs" ]] || die "the delegated cgroup does not permit process migration"

# Exercise the same child-cgroup operation used by shbox without moving the
# gate shell itself. The helper is the only process intentionally placed in
# this child; it must leave the child empty so cleanup never kills an unknown
# process. This is a capability check, not a best-effort probe.
private_cgroup="$cgroup_path/shbox-m8-${PPID}-$$-${RANDOM}"
mkdir -- "$private_cgroup" || die "cannot create a private delegated cgroup child"

cleanup_private_cgroup() {
  if [[ -d "$private_cgroup" ]]; then
    if [[ -s "$private_cgroup/cgroup.procs" ]]; then
      printf 'M8 Linux gate: refusing to remove non-empty test cgroup %s\n' "$private_cgroup" >&2
      return 1
    fi
    rmdir -- "$private_cgroup" || return 1
  fi
}
trap cleanup_private_cgroup EXIT

if ! sh -c '
  set -eu
  child=$1
  expected=$2
  printf "%s\n" "$$" > "$child/cgroup.procs"
  current=$(grep "^0::" /proc/self/cgroup | cut -d: -f3)
  [ "$current" = "$expected" ]
  for controller in cpu cpuset memory pids; do
    grep -Eq "(^|[[:space:]])${controller}($|[[:space:]])" "$child/cgroup.controllers"
  done
  grep -qx "$$" "$child/cgroup.procs"
' sh "$private_cgroup" "/$cgroup_relative"; then
  die "cannot move a helper into and inspect a private delegated cgroup child"
fi

cleanup_private_cgroup || die "private delegated cgroup child did not become empty"
trap - EXIT
private_cgroup=''

wrapper_root="$(mktemp -d -t shbox-arapuca.XXXXXX)" || die "cannot create a private Arapuca build directory"
trap 'rm -rf -- "$wrapper_root"' EXIT
cargo install --locked --git "$ARAPUCA_GIT_URL" --rev "$ARAPUCA_REVISION" arapuca \
  --bin arapuca --root "$wrapper_root" || die "cannot build Arapuca at the pinned revision"
wrapper_path="$wrapper_root/bin/arapuca"
[[ -f "$wrapper_path" && -x "$wrapper_path" ]] || die "pinned Arapuca wrapper was not installed"
export PATH="$wrapper_root/bin:$PATH"
wrapper_version="$("$wrapper_path" --version 2>&1)" || die "Arapuca wrapper cannot report its version"
[[ "$wrapper_version" == *"arapuca $ARAPUCA_VERSION"* ]] || \
  die "Arapuca wrapper reports an unexpected version: $wrapper_version"

rustc_host="$(rustc -vV | awk '$1 == "host:" { print $2 }')"
[[ "$rustc_host" == "$target" ]] || die "rustc host is $rustc_host, expected native target $target"

printf 'M8 Linux gate: %s %s, kernel %s, user %s (uid %s)\n' "$actual_machine" "$target" "$kernel_release" "$runner_user" "$uid"
printf 'M8 Linux gate: delegated cgroup %s with controllers cpu cpuset memory pids\n' "$cgroup_path"
printf 'M8 Linux gate: /proc/self/cgroup\n'
cat /proc/self/cgroup
printf 'M8 Linux gate: cgroup.controllers\n'
cat "$cgroup_path/cgroup.controllers"
printf 'M8 Linux gate: cgroup.subtree_control\n'
cat "$cgroup_path/cgroup.subtree_control"
printf 'M8 Linux gate: rustc -vV\n'
rustc -vV
printf 'M8 Linux gate: OpenSSH version\n'
ssh -V 2>&1
printf 'M8 Linux gate: Arapuca %s wrapper %s (declared revision %s)\n' "$ARAPUCA_VERSION" "$wrapper_path" "$ARAPUCA_REVISION"
printf 'M8 Linux gate: running locked native build and real OpenSSH suite\n'

cargo metadata --locked --no-deps --format-version 1 >/dev/null
cargo build --locked --release --target "$target"
SHBOX_RUN_ARAPUCA_INTEGRATION=1 cargo test --locked --target "$target" --test ssh_auth -- --test-threads=1

printf 'M8 Linux gate: PASS for native %s\n' "$expected_arch"
