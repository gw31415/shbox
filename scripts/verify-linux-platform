#!/usr/bin/env bash
# Blocking native Linux sandbox/PTTY platform gate.
#
# shbox owns process/PTY lifecycle on top of the in-workspace
# shbox-sandbox engine (clone3+pidfd, Landlock, seccomp, cgroup v2 when
# resource limits are configured). This gate requires no cgroup delegation:
# the default configuration runs without a dedicated cgroup.

set -euo pipefail
umask 077

readonly RUST_MINOR="1.95"

die() {
  printf 'Linux platform gate: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat >&2 <<'USAGE'
usage: scripts/verify-linux-platform --arch x86_64|aarch64 [--target TARGET]

Runs the native shbox Linux gate as the current non-root account. The gate
requires Rust 1.95, OpenSSH, a C compiler for the PTY identity fixture, and a
kernel with Landlock ABI 4+ (6.7+). No sibling runner binary or external
wrapper is used; cgroup resource limits stay optional.
USAGE
  exit 2
}

expected_arch=''
target=''
while (($# > 0)); do
  case "$1" in
    --arch)
      (($# >= 2)) || usage
      expected_arch="$2"
      shift 2
      ;;
    --arch=*)
      expected_arch="${1#*=}"
      shift
      ;;
    --target)
      (($# >= 2)) || usage
      target="$2"
      shift 2
      ;;
    --target=*)
      target="${1#*=}"
      shift
      ;;
    -h|--help)
      usage
      ;;
    *)
      usage
      ;;
  esac
done

case "$expected_arch" in
  x86_64)
    expected_machine='x86_64'
    default_target='x86_64-unknown-linux-gnu'
    ;;
  aarch64)
    expected_machine='aarch64'
    default_target='aarch64-unknown-linux-gnu'
    ;;
  *) usage ;;
esac

target="${target:-$default_target}"
[[ "$target" == "$default_target" ]] || die "target $target does not match native $expected_arch gate"

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd -- "$repo_root"

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "required command is missing: $1"
}

for command_name in awk cargo cc grep id rustc ssh ssh-keygen uname; do
  require_command "$command_name"
done
if rustc "+$RUST_MINOR" --version >/dev/null 2>&1 && cargo "+$RUST_MINOR" --version >/dev/null 2>&1; then
  rustc_gate() { rustc "+$RUST_MINOR" "$@"; }
  cargo_gate() { cargo "+$RUST_MINOR" "$@"; }
else
  rustc_gate() { rustc "$@"; }
  cargo_gate() { cargo "$@"; }
fi

[[ -x /bin/bash ]] || die "blocking interactive PTY suite requires /bin/bash"

[[ "$(uname -s)" == 'Linux' ]] || die "runner OS is not Linux"
actual_machine="$(uname -m)"
[[ "$actual_machine" == "$expected_machine" ]] || die "runner architecture is $actual_machine, expected $expected_machine"

uid="$(id -u)"
[[ "$uid" != '0' ]] || die "the platform gate must run as a non-root account"
runner_user="$(id -un)"
if [[ -n "${SHBOX_EXPECTED_USER:-}" && "$runner_user" != "$SHBOX_EXPECTED_USER" ]]; then
  die "runner account is $runner_user, expected $SHBOX_EXPECTED_USER"
fi

rustc_version="$(rustc_gate --version)"
[[ "$rustc_version" == "rustc $RUST_MINOR."* ]] || die "Rust $RUST_MINOR is required, got: $rustc_version"
grep -Fqx "rust-version = \"$RUST_MINOR\"" crates/shbox/Cargo.toml || die "shbox rust-version is not $RUST_MINOR"
grep -Fqx "rust-version = \"$RUST_MINOR\"" crates/shbox-sandbox/Cargo.toml || die "shbox-sandbox rust-version is not $RUST_MINOR"
if grep -Rnw crates --include=Cargo.toml -e 'nono' >/dev/null 2>&1; then
  die "a crate still depends on the retired nono confinement layer"
fi

rustc_host="$(rustc_gate -vV | awk '$1 == "host:" { print $2 }')"
[[ "$rustc_host" == "$target" ]] || die "rustc host is $rustc_host, expected native target $target"
kernel_release="$(uname -r)"

printf 'Linux platform gate: arch=%s target=%s kernel=%s user=%s uid=%s\n' \
  "$actual_machine" "$target" "$kernel_release" "$runner_user" "$uid"
printf 'Linux platform gate: %s\n' "$rustc_version"
printf 'Linux platform gate: OpenSSH version\n'
ssh -V 2>&1
if [[ -r /proc/self/cgroup ]]; then
  printf 'Linux platform gate: optional /proc/self/cgroup diagnostic (not a prerequisite)\n'
  cat /proc/self/cgroup
fi

# Exercise the exact engine API this launcher pins and print the detected
# Landlock ABI and cgroup state before the larger suite. This is a real
# kernel probe; failure is blocking.
printf 'Linux platform gate: engine/Landlock capability probe\n'
SHBOX_PLATFORM_DIAGNOSTICS=1 cargo_gate test --locked --target "$target" --bin shbox \
  platform::linux::tests::engine_capability_probe \
  -- --exact --nocapture --test-threads=1

printf 'Linux platform gate: locked native release build\n'
cargo_gate metadata --locked --no-deps --format-version 1 >/dev/null
cargo_gate build --locked --release --target "$target"

# This one command covers unit/compile behavior, real OpenSSH non-PTY and PTY
# sessions, filesystem/network denials, and normal/forced cleanup. The test
# harness starts the actual shbox daemon under this same unprivileged account.
printf 'Linux platform gate: full native sandbox + OpenSSH/PTTY acceptance\n'
SHBOX_RUN_SANDBOX_INTEGRATION=1 cargo_gate test --locked --target "$target" -- --test-threads=1
cargo_gate check --locked --all-targets --target "$target"

printf 'Linux platform gate: PASS for native %s\n' "$expected_arch"
