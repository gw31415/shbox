#!/usr/bin/env bash
# Blocking fixed-version macOS sandbox/PTTY platform gate.
#
# shbox owns process/PTY lifecycle and invokes Apple's sandbox-exec with a
# parent-built Seatbelt profile. No external wrapper or selfexec mode exists.

set -euo pipefail
umask 077

readonly RUST_MINOR="1.95"

die() {
  printf 'macOS platform gate: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat >&2 <<'USAGE'
usage: scripts/verify-macos-platform --os 15|26

Runs the real shbox Seatbelt + OpenSSH/PTTY gate on native arm64. The exact
macOS major is mandatory because sandbox-exec is deprecated and support is
established only by an explicit fixed-version passing run.
USAGE
  exit 2
}

expected_os=''
while (($# > 0)); do
  case "$1" in
    --os)
      (($# >= 2)) || usage
      expected_os="$2"
      shift 2
      ;;
    --os=*)
      expected_os="${1#*=}"
      shift
      ;;
    -h|--help)
      usage
      ;;
    *) usage ;;
  esac
done
case "$expected_os" in
  15|26) ;;
  *) usage ;;
esac

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd -- "$repo_root"

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "required command is missing: $1"
}
for command_name in cargo cc grep id rustc ssh ssh-keygen sw_vers uname; do
  require_command "$command_name"
done
if rustc "+$RUST_MINOR" --version >/dev/null 2>&1 && cargo "+$RUST_MINOR" --version >/dev/null 2>&1; then
  rustc_gate() { rustc "+$RUST_MINOR" "$@"; }
  cargo_gate() { cargo "+$RUST_MINOR" "$@"; }
else
  rustc_gate() { rustc "$@"; }
  cargo_gate() { cargo "$@"; }
fi

[[ -x /bin/bash ]] || die "blocking interactive PTY suite requires /bin/bash"

[[ "$(uname -s)" == 'Darwin' ]] || die "runner OS is not macOS"
actual_machine="$(uname -m)"
[[ "$actual_machine" == 'arm64' ]] || die "runner architecture is $actual_machine, expected native arm64"
actual_os="$(sw_vers -productVersion)"
actual_major="${actual_os%%.*}"
[[ "$actual_major" == "$expected_os" ]] || die "runner is macOS $actual_os, expected fixed macOS $expected_os"

uid="$(id -u)"
[[ "$uid" != '0' ]] || die "the platform gate must run as a non-root account"
runner_user="$(id -un)"
if [[ -n "${SHBOX_EXPECTED_USER:-}" && "$runner_user" != "$SHBOX_EXPECTED_USER" ]]; then
  die "runner account is $runner_user, expected $SHBOX_EXPECTED_USER"
fi

rustc_version="$(rustc_gate --version)"
[[ "$rustc_version" == "rustc $RUST_MINOR."* ]] || die "Rust $RUST_MINOR is required, got: $rustc_version"
grep -Fqx "rust-version = \"$RUST_MINOR\"" crates/shbox/Cargo.toml || die "shbox rust-version is not $RUST_MINOR"
grep -Fqx "rust-version = \"$RUST_MINOR\"" crates/shbox-sandbox/Cargo.toml || die "shbox-sandbox rust-version is not $RUST_MINOR"
target='aarch64-apple-darwin'
rustc_host="$(rustc_gate -vV | awk '$1 == "host:" { print $2 }')"
[[ "$rustc_host" == "$target" ]] || die "rustc host is $rustc_host, expected native target $target"

# There is no wrapper/selfexec compatibility path in the production source.
if grep -RnE 'ARAPUCA_|NONO_|selfexec' crates --include='*.rs' --include='Cargo.toml' >/dev/null 2>&1; then
  die "production source still contains a launcher-control/selfexec path"
fi

seatbelt='/usr/bin/sandbox-exec'
[[ -x "$seatbelt" ]] || die "Seatbelt prerequisite is missing: $seatbelt"
printf 'macOS platform gate: WARNING: sandbox-exec is deprecated; this gate proves only fixed macOS %s.\n' "$expected_os" >&2

# Tiny policy smoke: an allow-default profile must execute, while an explicit
# deny for the /etc subtree must actually block a read. This proves sandbox-exec is
# not merely present but enforcing the supplied profile.
allow_profile='(version 1)(allow default)'
deny_profile='(version 1)(allow default)(deny file-read* (subpath \"/etc\"))'
"$seatbelt" -p "$allow_profile" /usr/bin/true >/dev/null 2>&1 || \
  die "Seatbelt allow smoke failed"
if "$seatbelt" -p "$deny_profile" /bin/cat /etc/hosts >/dev/null 2>&1; then
  die "Seatbelt deny smoke did not block /etc/hosts"
fi

printf 'macOS platform gate: macOS=%s arch=%s user=%s uid=%s\n' \
  "$actual_os" "$actual_machine" "$runner_user" "$uid"
printf 'macOS platform gate: %s; Seatbelt deny/allow smoke passed\n' "$rustc_version"
printf 'macOS platform gate: OpenSSH version\n'
ssh -V 2>&1

cargo_gate metadata --locked --no-deps --format-version 1 >/dev/null
cargo_gate build --locked --release --target "$target"
printf 'macOS platform gate: full native Seatbelt + OpenSSH/PTTY acceptance\n'
SHBOX_RUN_SANDBOX_INTEGRATION=1 cargo_gate test --locked --target "$target" -- --test-threads=1
cargo_gate check --locked --all-targets --target "$target"

printf 'macOS platform gate: PASS for macOS %s arm64\n' "$expected_os"
